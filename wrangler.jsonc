{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fuf-browser-runtime-mcp",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "RUNTIME_RELAY", "class_name": "RuntimeRelay" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RuntimeRelay"] }
  ],
  "vars": {
    "RUNTIME_RELAY_ID": "runtime"
  }
}
